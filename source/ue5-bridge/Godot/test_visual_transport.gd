extends SceneTree
var checks:=0
var failures:Array=[]
func check(ok:bool,label:String)->void:checks+=1;if not ok:failures.append(label)
func _initialize()->void:
    var a=load("res://decoded_world_adapter.gd").new();a.zone_info={"x":35,"y":51}
    a.consume_world("you",{"oid":1,"region":200,"x":35*8192+400,"y":51*8192+400,"z":5200})
    a.consume_world("equipment",{"oid":7,"weapon_slots":0x22,"items":[{"slot":12,"model":19}]})
    check(not a.entities.has("npc:7"),"equipment cannot invent an NPC")
    a.consume_world("npc",{"oid":7,"x":35*8192+440,"y":51*8192+440,"z":5200,"model":310,"name":"Test","level":20,"heading":0,"speed":0})
    var row:Dictionary=a.entities["npc:7"]
    check(row.equipment.items.size()==1 and row.equipment.items[0].model==19 and row.equipment.weapon_slots==0x22,"equipment arriving before spawn survives with real slots and models")
    var first:int=row.equipment.revision
    a.consume_world("equipment",{"oid":7,"weapon_slots":0x10,"items":[{"slot":10,"model":445},{"slot":11,"model":59}]})
    check(row.equipment.revision>first and row.equipment.items.size()==2 and row.equipment.weapon_slots==0x10,"authoritative set and gear replacement")
    a.consume_world("equipment",{"oid":7,"weapon_slots":0x10,"items":[]})
    check(row.equipment.items.is_empty(),"empty equipment removes old weapons")
    a.consume_world("remove",{"oid":7,"type":1})
    a.consume_world("npc",{"oid":7,"x":35*8192+440,"y":51*8192+440,"z":5200,"model":118,"name":"Replacement","heading":0,"speed":0})
    check(not a.entities["npc:7"].has("equipment"),"OID reuse cannot inherit previous living's gear")
    a.clear_world();check(a.equipment_packets.is_empty(),"region/session cleanup clears equipment cache")
    var fx=load("res://spell_visual_state.gd").new();var ids:={7:"npc:7",8:"npc:8"}
    fx.consume("you",{},1,ids,1000)
    check(fx.snapshot(1100).is_empty(),"no optimistic effect without a packet")
    fx.consume("spell_effect",{"caster":1,"target":1,"spell":4301},1,ids,1100)
    check(fx.snapshot(1100).is_empty(),"restored login buffs do not explode visually")
    fx.consume("cast",{"caster":1,"spell":4101,"time":30},1,ids,5000)
    var events:Array=fx.snapshot(5200)
    check(events.size()==1 and events[0].duration_ms==3000 and events[0].age_ms==200 and events[0].caster=="player:local","original preparation time and caster identity")
    check(not events[0].has("at_ms"),"process clock is not exposed as portable time")
    fx.consume("interrupt",{"caster":1},1,ids,5300)
    check(fx.snapshot(5300).back().kind=="cancel","interruption explicitly drops hand effects")
    fx.consume("spell_effect",{"caster":7,"target":1,"spell":4101,"success":0,"bolt":7},1,ids,5500)
    var e:Dictionary=fx.snapshot(5500).back()
    check(e.kind=="release" and e.caster=="npc:7" and e.target=="player:local" and e.resisted and e.bolt==7,"remote resisted effect retains original endpoints and bolt flag")
    var count:int=fx.events.size();fx.consume("cast",{"caster":99,"spell":4101,"time":10},1,ids,5600)
    check(fx.events.size()==count,"unknown caster cannot produce a fabricated visual")
    fx.consume("cast",{"caster":1,"spell":5292,"time":0},1,ids,5700)
    check(fx.snapshot(5700).back().duration_ms==0,"instant effect has no windup")
    fx.consume("spell_effect",{"caster":1,"target":7,"spell":5292,"success":1},1,ids,5800)
    fx.consume("spell_effect",{"caster":1,"target":8,"spell":5292,"success":1},1,ids,5801)
    events=fx.snapshot(5801);check(events[-2].target=="npc:7" and events[-1].target=="npc:8","area cast preserves every original target")
    fx.consume("death",{"oid":7},1,ids,5900)
    check(fx.snapshot(5900).back().kind=="cancel" and fx.snapshot(5900).back().caster=="npc:7","death cancels the caster's lingering gather")
    for i in 150:fx.consume("spell_effect",{"caster":7,"target":1,"spell":4101},1,ids,6000+i)
    check(fx.events.size()==96,"visual packet history is bounded")
    check(fx.snapshot(15000).is_empty(),"old visual events expire")
    fx.consume("cast",{"caster":1,"spell":4101,"time":20},1,ids,16000);fx.consume("region_changed",{},1,ids,16100)
    check(fx.snapshot(16100).is_empty() and fx.active.is_empty(),"region change removes pending effects")
    var transport=load("res://visual_bridge.gd").new()
    transport.snapshot_metadata["spell_visuals"]=[{"seq":1,"kind":"cast","effect_id":4101}]
    check(transport.publish(a.entities.values()),"snapshot publication succeeds")
    check(transport.last_snapshot.get("spell_visuals",[]).size()==1,"original FX announcements cross the actual transport whitelist")
    var light:={"pos":[1374.15,134.25,1242.75],"color":[0.745,0.302,1.0],"range_m":6.4}
    transport.snapshot_metadata["zone_lights"]=[light]
    check(transport.publish([]) and transport.last_snapshot.get("zone_lights",[])==[light],"original point lights cross transport independently of NPC presence")
    transport.snapshot_metadata["zone_lights"]=[];transport.publish([])
    check(transport.last_snapshot.get("zone_lights",[light]).is_empty(),"empty light set can clear previous zone lights")
    transport.snapshot_metadata["exchange"]={"visible":false,"catalog_revision":1};transport.publish([])
    check(transport.last_snapshot.get("exchange",{})=={"visible":false,"catalog_revision":1},"exchange state crosses the bounded transport whitelist")
    transport.free()
    a.free();var report:={"passed":failures.is_empty(),"checks":checks,"failures":failures,"real_server":false};var f:=FileAccess.open(get_script().resource_path.get_base_dir().path_join("../Reports/training_staff_fx_pets/godot_visual_tests.json"),FileAccess.WRITE);f.store_string(JSON.stringify(report));f.close();print(JSON.stringify(report));quit(0 if failures.is_empty() else 1)
