extends SceneTree
class Server extends Node:
    var playing:=true
    var info:Dictionary={"guild":"QA Guild"}
    var commands:Array=[]
    func command(text:String)->void:commands.append(text)
    func class_name_of(id:int)->String:return "" if id==53 else "Class %d" % id
var checks:=0
var failures:Array=[]
func check(value:bool,name:String)->void:
    checks+=1
    if not value:failures.append(name)
func message(state:RefCounted,server:Node,text:String,now:int=200)->void:state.consume("message",{"type":0x64,"text":text},server,now)
func _initialize()->void:
    var state=load("res://guild_state.gd").new();var server:=Server.new()
    state.sync(server,"QaPlayer",0)
    check(state.guild=="QA Guild" and not state.visible,"membership sync does not open a window or request data")
    check(server.commands.is_empty(),"sync never modifies guild data or sends commands")
    check(state.request({"action":"guild_open","open":true},server,100),"original guild window opens")
    check(server.commands==["/gc who window 1 1 0"],"guild uses exact original roster command")
    check(state.snapshot().pending and state.snapshot().stale,"new roster disables member actions until complete")
    message(state,server,'TA,1,1,1');message(state,server,'A,1,1,QaOther,15,43,4,2,"Connacht","QA Second Guild"')
    check(state.members.is_empty() and state.snapshot().pending,"wrong-tab response cannot replace active guild roster")
    message(state,server,'TE,1,2,2');message(state,server,'E,1,2,QaOak,10,42,2,1,"Connacht","Guard, west gate"')
    check(state.members.size()==1 and state.members[0].note=="Guard, west gate","CSV preserves comma inside original quoted note")
    check(state.members[0].class_name=="Class 42" and state.members[0].online,"class and online status come from original row")
    check(state.snapshot().pending,"partial roster remains pending")
    message(state,server,'E,1,2,QaOak,10,42,2,1,"Connacht","duplicate"')
    check(state.members.size()==1,"duplicate position is ignored")
    message(state,server,'E,2,2,QaBirch,12,47,5,0,"2 days ago","Offline member"')
    check(state.members.size()==2 and not state.members[1].online,"offline members retain last-on text")
    check(not state.snapshot().pending and not state.snapshot().stale,"complete response enables current roster")
    check(not state.request({"action":"guild_refresh","guild_token":state.token,"tab":"alliance","page":2,"show_offline":true},server,150) and state.tab=="guild" and state.page==1 and not state.show_offline,"rapid rejected refresh preserves the currently displayed query")
    var tok:String=state.token;var member_tok:String=state.members[0].token
    var n:=server.commands.size()
    check(not state.request({"action":"guild_member","guild_token":"stale","member_token":member_tok,"verb":"promote"},server,500),"old character/window token rejected")
    check(not state.request({"action":"guild_member","guild_token":tok,"member_token":"bad","verb":"promote"},server,500),"unknown member token rejected")
    check(server.commands.size()==n,"stale tokens send no guild mutation")
    check(state.request({"action":"guild_member","guild_token":tok,"member_token":member_tok,"verb":"promote"},server,500),"promote dispatches original request")
    check(server.commands.back()=="/gc promote QaOak 1","promotion target derives from current server rank")
    check(state.members[0].rank==2,"client does not invent a successful promotion")
    check(state.snapshot().pending,"rank action waits before original refresh")
    state.sync(server,"QaPlayer",1400)
    check(server.commands.back()=="/gc who window 1 1 0","rank request schedules normal roster refresh")
    message(state,server,'TE,1,1,1',1450);message(state,server,'E,1,1,QaOak,10,42,1,1,"Connacht","Guard"',1450)
    check(state.members[0].rank==1 and state.members[0].token!=member_tok,"server response changes rank and member identity token")
    member_tok=state.members[0].token;n=server.commands.size()
    check(not state.request({"action":"guild_member","guild_token":tok,"member_token":member_tok,"verb":"remove"},server,1700),"member removal needs confirmation")
    check(server.commands.size()==n,"unconfirmed removal sends nothing")
    check(state.request({"action":"guild_member","guild_token":tok,"member_token":member_tok,"verb":"remove","confirmed":true},server,1700),"confirmed removal uses server command")
    check(server.commands.back()=="/gc remove QaOak" and state.members.size()==1,"removal never erases local membership optimistically")
    state.sync(server,"QaPlayer",2600)
    state.sync(server,"QaPlayer",6700)
    check(not state.snapshot().pending and state.snapshot().stale,"timed out refresh stays stale")
    check(not state.request({"action":"guild_member","guild_token":tok,"member_token":member_tok,"verb":"demote"},server,7050),"stale roster cannot modify member rank")
    check(state.request({"action":"guild_refresh","guild_token":tok,"tab":"alliance","sort":8,"page":1,"show_offline":true},server,7200),"alliance query accepts original sort/offline fields")
    check(server.commands.back()=="/gc who window 8 1 1 1","alliance uses original final one flag")
    message(state,server,'TA,1,1,1',7250);message(state,server,'A,1,1,QaElm,15,43,4,2,"Connacht","QA Second Guild"',7250)
    check(state.members[0].guild=="QA Second Guild" and state.members[0].note=="","alliance final field represents guild, not note")
    member_tok=state.members[0].token
    check(not state.request({"action":"guild_member","guild_token":tok,"member_token":member_tok,"verb":"promote"},server,7500),"alliance roster cannot send guild rank actions")
    check(state.request({"action":"guild_member","guild_token":tok,"member_token":member_tok,"verb":"invite"},server,7500),"original group invite is available for alliance member")
    check(server.commands.back()=="/invite QaElm","group invite names selected roster member")
    state.request({"action":"guild_open","open":false},server,7600)
    message(state,server,'TA,1,0,0',7650)
    check(not state.visible and state.members.size()==1,"closed window ignores late social response")
    state.sync(server,"QaSecond",7800)
    check(not state.visible and state.members.is_empty() and state.token!=tok,"character switch clears roster and invalidates tokens")
    server.info.guild="None";state.sync(server,"QaSecond",7900);n=server.commands.size();state.request({"action":"guild_open"},server,8000)
    check(state.guild.is_empty() and state.visible and server.commands.size()==n,"no-guild player gets original empty window without a query")
    server.info.guild="QA Guild";state.sync(server,"QaSecond",8100);tok=state.token;state.request({"action":"guild_open"},server,8200);message(state,server,'TE,1,0,0',8250)
    check(state.members.is_empty() and not state.snapshot().pending,"empty roster clears previous members")
    check(not state.request({"action":"guild_refresh","guild_token":tok,"page":0},server,8800),"zero page rejected")
    check(not state.request({"action":"guild_refresh","guild_token":tok,"sort":9},server,8800),"unsupported sort rejected")
    check(state.request({"action":"guild_refresh","guild_token":tok,"page":2,"sort":-1},server,8800),"original page two and descending sort accepted")
    message(state,server,'TE,2,11,1',8850);message(state,server,'E,11,11,QaLast,20,53,9,0,"Yesterday","Last"',8850)
    check(state.page==2 and state.total==11 and state.members[0].position==11,"page-two positions and total preserved")
    check(state.members[0].class_name=="Naturalist","original base class names remain visible when the advanced-class catalog omits them")
    member_tok=state.members[0].token
    check(not state.request({"action":"guild_member","guild_token":tok,"member_token":member_tok,"verb":"demote"},server,8800),"rank nine cannot be demoted beyond bounds")
    check(not state.request({"action":"guild_leave","guild_token":tok},server,8800),"leaving guild needs confirmation")
    check(state.request({"action":"guild_info","guild_token":tok},server,8800) and server.commands.back()=="/gc info","guild info uses server command")
    check(state.request({"action":"guild_motd","guild_token":tok},server,8800) and server.commands.back()=="/gc motd","MOTD uses server command")
    check(state.request({"action":"guild_leave","guild_token":tok,"confirmed":true},server,8800) and server.commands.back()=="/gc quit","confirmed leave remains server-authoritative")
    check(state.guild=="QA Guild","client does not fabricate successful guild leave")
    server.info.guild="";state.sync(server,"QaSecond",8900)
    check(state.visible and state.guild.is_empty() and state.members.is_empty(),"server membership removal clears roster and keeps empty window")
    server.playing=false;state.sync(server,"QaSecond",9000)
    check(not state.visible and not state.request({"action":"guild_open"},server,9100),"logout closes window and rejects subsequent requests")
    check(state.csv('E,1,1,Qa,5,42,1,1,"Connacht","unterminated').is_empty(),"unclosed CSV quote rejected")
    check(state.csv('a,'.repeat(20)).is_empty(),"CSV field count bounded")
    check(not state.valid_name("Qa\n/gc quit") and not state.valid_name("Qa Other"),"command target cannot contain delimiters")
    server.free();print(JSON.stringify({"passed":failures.is_empty(),"checks":checks,"failures":failures}));quit(0 if failures.is_empty() else 1)
